{
  "title": "FlukeDrums",
  "children": [
    {
      "title": "FlukeDrums",
      "children": [
        {
          "title": "The Idea",
          "lines": [
            "Random kit from a",
            "big sample pool.",
            "",
            "Roll: 16 new pads.",
            "Lock the keepers,",
            "roll again. Only",
            "unlocked pads",
            "change.",
            "",
            "Save Kit copies the",
            "16 files into your",
            "Samples folder."
          ]
        },
        {
          "title": "Quick Start",
          "lines": [
            "1 Folder: turn knob",
            "  8, or click Folder",
            "  for the full list.",
            "2 Click Roll.",
            "3 Like a pad? Hit",
            "  it, turn knob 1",
            "  (Lock) to on.",
            "4 Roll again.",
            "5 Undo Roll if you",
            "  lost something.",
            "6 Save Kit."
          ]
        },
        {
          "title": "Actions",
          "lines": [
            "Roll: all unlocked",
            "Roll Pad: current",
            "  pad only",
            "Undo Roll: back one",
            "  roll (32 deep)",
            "Save Kit: copy to",
            "  Samples/Schwung/",
            "  FlukeDrums/<date>",
            "Rescan: reread pool",
            "Unlock All"
          ]
        },
        {
          "title": "Pool Settings",
          "lines": [
            "Folder: My = your",
            "  Samples, Core =",
            "  Ableton's library.",
            "  (N) = sample count",
            "  incl. subfolders.",
            "Up One: widen pool",
            "  one folder level.",
            "Browse: any deeper",
            "  folder. Pick any",
            "  file inside it.",
            "Subfolders: on/off",
            "Max Len: skip files",
            "  longer than this",
            "  (0 = no limit).",
            "Rescan: after you",
            "  add samples."
          ]
        },
        {
          "title": "Tips",
          "lines": [
            "Auto Select on: the",
            "last pad you hit is",
            "the one Lock and",
            "Roll Pad act on.",
            "",
            "Point Pool at Core",
            "Library samples for",
            "Ableton's own set:",
            "/data/CoreLibrary"
          ]
        }
      ]
    },
    {
      "title": "Overview",
      "lines": [
        "16-pad drum sampler",
        "for Schwung.",
        "",
        "Pads map to notes",
        "36..51.",
        "",
        "No sound until a",
        "pad Sample is set."
      ]
    },
    {
      "title": "Setup",
      "children": [
        {
          "title": "Sample",
          "lines": [
            "Open Pad Settings,",
            "select Sample.",
            "",
            "Choose wav/aif",
            "from /data, incl.",
            "UserLibrary and",
            "CoreLibrary."
          ]
        },
        {
          "title": "Browse Behavior",
          "lines": [
            "Live preview while",
            "browsing files.",
            "",
            "Back restores",
            "previous sample.",
            "Select commits."
          ]
        }
      ]
    },
    {
      "title": "Global",
      "lines": [
        "Master Vol:",
        "overall level",
        "Polyphony:",
        "active voice cap",
        "Vel Curve:",
        "linear/soft/hard",
        "Humanize:",
        "timing random ms",
        "Random Seed:",
        "static random seed",
        "Rand Loop Steps:",
        "random loop length"
      ]
    },
    {
      "title": "Pad Settings",
      "lines": [
        "Auto Select:",
        "switch pad from",
        "incoming notes",
        "",
        "Current Pad:",
        "edit target 1..16",
        "",
        "Pad controls are",
        "stored per pad."
      ]
    },
    {
      "title": "Pad Controls",
      "lines": [
        "Sample, Vol, Pan,",
        "Tune, Start,",
        "Attack, Decay,",
        "Choke, Mode",
        "",
        "Start uses native",
        "wav_position in",
        "range 0.00..1.00",
        "",
        "Rand Pan/Vol/Dec,",
        "Chance"
      ]
    },
    {
      "title": "Tips",
      "lines": [
        "For live tweaks,",
        "set Auto Select",
        "to off.",
        "",
        "Use Random Seed",
        "for repeatable",
        "random behavior."
      ]
    },
    {
      "title": "Disclaimer",
      "lines": [
        "Developed with",
        "AI assistance.",
        "",
        "Design + release",
        "decisions are",
        "human-reviewed."
      ]
    }
  ]
}

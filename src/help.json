{
  "title": "FlukeDrums",
  "children": [
    {
      "title": "The Idea",
      "lines": [
        "Random kit from a",
        "big sample pool.",
        "",
        "Roll: 16 new pads.",
        "Lock the keepers,",
        "roll again. Only",
        "unlocked pads",
        "change.",
        "",
        "Save Kit copies the",
        "16 files into your",
        "Samples folder."
      ]
    },
    {
      "title": "Quick Start",
      "lines": [
        "Knobs go left to",
        "right, in order:",
        "1 Folder: pick the",
        "  pool (click for",
        "  the full list).",
        "4 Roll: turn it.",
        "5 Like the pad you",
        "  just hit? Turn",
        "  Lock clockwise.",
        "Roll again. Undo",
        "  is knob 7.",
        "8 Save Kit."
      ]
    },
    {
      "title": "Actions",
      "lines": [
        "Page 1, left to",
        "right:",
        "1 Folder 2 Up One",
        "3 Max Len 4 Roll",
        "5 Lock 6 Roll Pad",
        "7 Undo 8 Save Kit",
        "",
        "Roll: unlocked pads",
        "Roll Pad: current",
        "Undo: back one roll",
        "  (32 deep; locked",
        "  pads stay put)",
        "Save Kit: copies to",
        "  Samples/Schwung/",
        "  FlukeDrums/<date>"
      ]
    },
    {
      "title": "Pool Settings",
      "lines": [
        "Page 1, knobs 1-3:",
        "  Folder, Up One,",
        "  Max Len.",
        "Folder: My = your",
        "  Samples, Core =",
        "  Ableton's library.",
        "  (N) = sample count",
        "Up One: widen pool",
        "  one folder level.",
        "Pool page:",
        "Subfolders: on/off",
        "Rescan: after you",
        "  add samples.",
        "Browse: any deeper",
        "  folder. Pick any",
        "  file inside it.",
        "Unlock All",
        "Max Len: skip files",
        "  longer (0 = off).",
        "Folder Depth (page",
        "  after Pool): how",
        "  deep the Folder",
        "  list reaches,",
        "  2-7 (default 5)."
      ]
    },
    {
      "title": "Kit Mode",
      "lines": [
        "Pool page, knob 1.",
        "On: pads 1-8 build",
        "  a real kit, found",
        "  by sample names:",
        "1-2 kick 3 snare",
        "4 clap 5 closed hat",
        "6 open hat",
        "7 crash/ride 8 tom",
        "9-16: wild cards.",
        "No match: random.",
        "Kit Parts: how many",
        "  of the 8 found a",
        "  match (x/8).",
        "Roll Pad keeps the",
        "  pad's part.",
        "Off: all random."
      ]
    },
    {
      "title": "Roll Tips",
      "lines": [
        "Auto Select on: the",
        "last pad you hit is",
        "the one Lock and",
        "Roll Pad act on.",
        "",
        "Point Pool at Core",
        "Library samples for",
        "Ableton's own set:",
        "/data/CoreLibrary"
      ]
    },
    {
      "title": "Sound Engine",
      "children": [
        {
          "title": "Overview",
          "lines": [
            "16-pad drum sampler",
            "for Schwung.",
            "",
            "Pads map to notes",
            "36..51.",
            "",
            "Silent until you",
            "Roll, or set a",
            "pad's Sample."
          ]
        },
        {
          "title": "Setup",
          "children": [
            {
              "title": "Sample",
              "lines": [
                "Open the Pad page,",
                "select Sample.",
                "",
                "Choose wav/aif",
                "from /data, incl.",
                "UserLibrary and",
                "CoreLibrary."
              ]
            },
            {
              "title": "Browse Behavior",
              "lines": [
                "Live preview while",
                "browsing files.",
                "",
                "Back restores",
                "previous sample.",
                "Select commits."
              ]
            }
          ]
        },
        {
          "title": "Global",
          "lines": [
            "Master Vol:",
            "overall level",
            "Polyphony:",
            "active voice cap",
            "Vel Curve:",
            "linear/soft/hard",
            "Humanize:",
            "timing random ms",
            "Random Seed:",
            "static random seed",
            "Rand Loop Steps:",
            "random loop length"
          ]
        },
        {
          "title": "Pad Page",
          "lines": [
            "Auto Select:",
            "switch pad from",
            "incoming notes",
            "",
            "Current Pad:",
            "edit target 1..16",
            "",
            "Pad controls are",
            "stored per pad."
          ]
        },
        {
          "title": "Pad Controls",
          "lines": [
            "Sample, Vol, Pan,",
            "Tune, Start,",
            "Attack, Decay,",
            "Choke, Mode",
            "",
            "Start uses native",
            "wav_position in",
            "range 0.00..1.00",
            "",
            "Rand Pan/Vol/Dec,",
            "Chance"
          ]
        },
        {
          "title": "Sound Tips",
          "lines": [
            "For live tweaks,",
            "set Auto Select",
            "to off.",
            "",
            "Use Random Seed",
            "for repeatable",
            "random behavior."
          ]
        }
      ]
    },
    {
      "title": "Disclaimer",
      "lines": [
        "Developed with",
        "AI assistance.",
        "",
        "Design + release",
        "decisions are",
        "human-reviewed."
      ]
    }
  ]
}
